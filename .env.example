# Vercel AI Gateway key. Powers both the interviewer and the grader.
# Get one at https://vercel.com/ai-gateway, or run `vercel link && vercel env pull`
# to use OIDC instead.
AI_GATEWAY_API_KEY=

# Optional model overrides.
# SCRIM_INTERVIEWER_MODEL=anthropic/claude-haiku-4.5
# SCRIM_GRADER_MODEL=anthropic/claude-opus-5
